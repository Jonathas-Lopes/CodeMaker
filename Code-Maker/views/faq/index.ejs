<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Central de Dúvidas (FAQ)</title>
</head>
<body>
    <h1>Central de Dúvidas (FAQ)</h1>
    <a href="/faq/novo"><button>Nova Dúvida</button></a>
    <br><br>
    
    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>ID</th>
                <th>Pergunta</th>
                <th>Resposta</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% faqs.forEach(faq => { %>
                <tr>
                    <td><%= faq.id %></td>
                    <td><%= faq.pergunta %></td>
                    <td><%= faq.resposta %></td>
                    <td>
                        <form action="/faq/excluir/<%= faq.id %>" method="POST" style="display:inline;">
                            <button type="submit" onclick="return confirm('Tem a certeza que deseja excluir esta dúvida?')">Excluir</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>