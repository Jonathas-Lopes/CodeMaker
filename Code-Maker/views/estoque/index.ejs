<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Estoque</title>
</head>

<body>
    <h1>Estoque e Variações</h1>
    <a href="/estoque/novo">Cadastrar novo produto</a>

    <br><br>

    <table border="1">
        <tr>
            <th>ID</th>
            <th>Produto</th>
            <th>Variação</th>
            <th>Quantidade</th>
            <th>Ação</th>
        </tr>

        <% estoque.forEach(item => { %>
            <tr>
                <td><%= item.id %></td>
                <td><%= item.produto %></td>
                <td><%= item.variacao %></td>
                <td><%= item.quantidade %></td>
                <td>
                    <form action="/estoque/excluir/<%= item.id %>" method="POST">
                        <button type="submit">Excluir</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>