
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Itens do Pedido</title>

    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/itens.css">
</head>

<body>

    
    <nav class="navbar navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                Code-Maker
            </a>

            <span class="navbar-text">
                Vendas & Checkout
            </span>
        </div>
    </nav>


    
    <main class="container py-5">

        
        <div class="page-header mb-5">

            <div> 

                <h1>Itens do Pedido</h1>

                <p>
                    Confira os produtos e informações dos pedidos cadastrados.
                </p>
            </div>

        </div>


        
        <div class="row g-4">

            <% itens.forEach(item => { %>

                <div class="col-12 col-sm-6 col-lg-4">

                    <div class="product-card">

                        
                        <div class="product-image-container">

                            <img
                                src="/images/produtos/<%= item.foto %>"
                                class="product-image"
                                alt="<%= item.produto %>"
                            >

                        </div>

                        
                        <div class="product-content">

                            <div class="product-header">

                                <span class="product-category">
                                    Pedido #<%= item.pedidoId %>
                                </span>

                            </div>


                            <h2>
                                <%= item.produto %>
                            </h2>


                            <div class="product-info">

                                <div class="info-item">

                                    <span class="info-label">
                                        Quantidade
                                    </span>

                                    <span class="info-value">
                                        <%= item.quantidade %>
                                    </span>

                                </div>


                                <div class="info-item">

                                    <span class="info-label">
                                        Subtotal
                                    </span>

                                    <span class="price">
                                        R$ <%= item.subtotal.toFixed(2).replace('.', ',') %>
                                    </span>

                                </div>

                            </div>


                            <button class="btn-details">
                                Ver detalhes
                            </button>

                        </div>

                    </div>

                </div>

            <% }); %>

        </div>

    </main>

    <footer class="footer">

        <div class="container">

            <p>
                Itens do pedido
            </p>

        </div>

    </footer>


    <script src="/javascripts/bootstrap.min.js"></script>

</body>

</html>

<style>
        
    body {
        background-color: #f4f6f8;
        color: #222;
        font-family:Georgia, 'Times New Roman', Times, serif
    }

    .navbar-custom {
        background-color: #1f2937;
        padding: 30px;

    }

    .navbar-brand {
        color: white !important;
        font-weight: bold;
    }

    .navbar-text {
        color: white !important;
    }

    .page-header h1 {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .page-header p {
        color: #666;
    }

    .badge-custom {
        background-color: #dbeafe;
        color: #1f2937;

        padding: 6px 12px;
        border-radius: 20px;

        font-size: 12px;
        font-weight: bold;
    }

    .product-card {
        height: 100%;

        background-color: white;

        border: 1px solid #bbbec5;
        border-radius: 16px;

        overflow: hidden;

        transition: 0.2s;
    }

    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.10);
    }

    .product-image-container {
        width: 100%;
        height: 220px;

        background-color: #eee;
    }

    .product-image {
        width: 100%;
        height: 100%;

        object-fit: cover;
    }

    .product-content {
        padding: 18px;
    }

    .product-category {
        color: #1f2937;
        font-size: 13px;
        font-weight: bold;
    }

    .product-content h2 {
        font-size: 20px;
        margin: 10px 0 18px;
    }

    .product-info {
        display: flex;
        justify-content: space-between;

        border-top: 1px solid #eee;
        border-bottom: 1px solid #eee;

        padding: 12px 0;
        margin-bottom: 15px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        color: #888;
        font-size: 12px;
    }

    .info-value {
        font-weight: bold;
        margin-top: 10px;
    }

    .price {
        color: #1f2937;
        font-weight:bolder;
    }

    .btn-details:hover {
        background-color: #1f2937;
    }

    .footer {
        background-color: #1f2937;
        padding: 20px 0;
        margin-top: 40px;

        text-align: center;
    }

    .footer p {
        color: #aaa;
        margin: 0;
    }

</style>
