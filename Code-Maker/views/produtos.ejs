
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos</title>
    <!-- Correto -->
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
</head>

<body>

    <div class="container py-4">
        <h1 class="mb-4">Lista de Produtos</h1>
        <a href="/produtos/novo" class="btn btn-primary mb-3">+ Novo Produto</a>

        <div class="row">
            <% produtos.forEach(produto=> { %>
                <div class="col-md-4">
                    <div class="card">
                        <img style="height: 50vh" src="/images/<%= produto.foto %>" class="card-img-top" alt="<%= produto.nome %>">
                        <div class="card-body" style="height: 30%;">
                            <h5 class="card-title">
                                <%= produto.nome %>
                            </h5>
                            <p class="card-text">
                                <%= produto.descricao %>
                            </p>
                            <form action="/produtos/excluir/<%= produto.id %>" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Tem certeza que deseja excluir este produto?')">Excluir</button>
                            </form>
                        </div>
                    </div>
                </div>
                <% }); %>
        </div>
    </div>

    <script src="/javascripts/bootstrap.min.js"></script>
</body>

</html>
