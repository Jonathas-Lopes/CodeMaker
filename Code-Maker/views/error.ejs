<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Erro</title>
</head>

<body>

    <h1>Ocorreu um erro</h1>

    <h2><%= message %></h2>

    <% if (error && error.stack) { %>
        <pre><%= error.stack %></pre>
    <% } %>

</body>

</html>